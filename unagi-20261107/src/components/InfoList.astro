---
import site from '../data/site.json';
import { t, pick, type Lang } from '../lib/i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang);
---
<dl class="info-list">
  <div><dt>{d.ui.hours}</dt><dd>{site.hours}<span class="muted">（{d.ui.lastEntry} {site.lastEntry}）</span></dd></div>
  <div><dt>{d.ui.closed}</dt><dd>{site.closed[lang]}</dd></div>
  <div><dt>{d.ui.address}</dt><dd>{lang === 'ja' ? site.address.ja : site.address.en}</dd></div>
  <div><dt>{d.ui.station}</dt><dd>{pick(site.station, lang)}</dd></div>
  <div><dt>{d.ui.phone}</dt><dd><a href={`tel:${site.phoneIntl}`}>{lang === 'ja' ? site.phone : site.phoneIntlDisplay}</a></dd></div>
</dl>
