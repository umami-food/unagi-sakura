---
import Base from '../layouts/Base.astro';
import { LANGS, t, pagePath } from '../lib/i18n';
const d = t('ja');
---
<Base lang="ja" page={null} title={`${d.notFound.title}｜炭火うなぎSakura`} description={d.notFound.body}>
  <section class="section">
    <div class="wrap narrow">
      <h1>{d.notFound.title}</h1>
      <ul class="nf-list">
        {LANGS.map((l) => (
          <li lang={t(l).lang.html}><strong>{t(l).notFound.title}</strong><br /><span class="muted">{t(l).notFound.body}</span><br /><a href={pagePath(l, 'home')}>{t(l).ui.backHome}</a></li>
        ))}
      </ul>
    </div>
  </section>
</Base>
