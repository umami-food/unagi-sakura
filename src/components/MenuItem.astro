---
import { t, pick, yen, withBase, type Lang } from '../lib/i18n';
interface Props { lang: Lang; item: any; showImage?: boolean }
const { lang, item, showImage = true } = Astro.props;
const d = t(lang);
---
<article class="menu-item" id={item.id}>
  {showImage && <img src={withBase('images/' + item.image)} alt={pick(item.name, lang)} width="1200" height="900" loading="lazy" decoding="async" />}
  <div class="menu-item-body">
    <h2>{pick(item.name, lang)}</h2>
    <p class="menu-desc">{pick(item.desc, lang)}</p>
    <ul class="size-list">
      {item.sizes.map((s: any) => (
        <li><span>{pick(s.label, lang)}{s.recommended && <em class="rec">{d.ui.recommended}</em>}</span><strong>{yen(s.price)}</strong></li>
      ))}
    </ul>
    <div class="menu-box">
      <p>{pick(item.includes, lang)}</p>
      <p class="box-title">{d.menu.riceTitle}</p>
      <ul class="rice-list">{item.rice.map((r: any) => <li><span>{pick(r.label, lang)}</span><span>{r.add ? `+${yen(r.add)}` : ''}</span></li>)}</ul>
    </div>
  </div>
</article>
