---
import site from '../data/site.json';
import InstagramIcon from './InstagramIcon.astro';
import { LANGS, t, pagePath, type Lang, type PageKey } from '../lib/i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang);
const navPages: PageKey[] = ['home', 'menu', 'guide', 'access', 'faq', 'reserve'];
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="wrap footer-grid">
    <div>
      <p class="footer-logo" lang="ja"><span class="logo-seal" aria-hidden="true">鰻</span> 炭火うなぎSakura</p>
      <p lang="ja">{site.address.ja}</p>
      <p><a href={`tel:${site.phoneIntl}`}>{lang === 'ja' ? site.phone : site.phoneIntlDisplay}</a></p>
      <p>{d.ui.hours} {site.hours}（{d.ui.lastEntry} {site.lastEntry}）／{d.ui.closed}：{site.closed[lang]}</p>
      <p class="footer-sns"><a href={site.instagram} target="_blank" rel="noopener"><InstagramIcon /> Instagram {site.instagramHandle}</a></p>
      <p class="footer-sns"><a href={site.tabelog} target="_blank" rel="noopener">{d.home.tabelogCta}</a></p>
    </div>
    <nav aria-label="Sitemap">
      <ul>{navPages.map((p) => <li><a href={pagePath(lang, p)}>{d.nav[p]}</a></li>)}</ul>
    </nav>
    <div>
      <p class="footer-head">{d.ui.language}</p>
      <ul>{LANGS.map((l) => <li><a href={pagePath(l, 'home')} lang={t(l).lang.html}>{t(l).lang.label}</a></li>)}</ul>
      <p class="footer-head footer-dinner">{d.home.dinnerTitle}</p>
      <p><a href={site.dinnerSite} target="_blank" rel="noopener" lang="ja">和牛すき焼きしゃぶしゃぶSakura 名古屋店</a></p>
    </div>
  </div>
  <div class="wrap"><p class="copyright">© {year} 炭火うなぎSakura</p></div>
</footer>
