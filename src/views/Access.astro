---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import InfoList from '../components/InfoList.astro';
import MapLinks from '../components/MapLinks.astro';
import TaxiCard from '../components/TaxiCard.astro';
import { t, type Lang } from '../lib/i18n';
const { lang } = Astro.props as { lang: Lang };
const d = t(lang);
const a = d.access;
---
<Base lang={lang} page="access" title={d.seo.access.title} description={d.seo.access.description}>
  <PageHead title={a.title} lead={a.lead} />
  <section class="section">
    <div class="wrap info-grid">
      <div>
        <MapLinks lang={lang} />
        <p class="muted note">{a.floorNote}</p>
        <h2 class="sub">{a.directionsTitle}</h2>
        <ol class="steps small">{a.directions.map((s: string, i: number) => <li><span class="num">{i + 1}</span><div><p>{s}</p></div></li>)}</ol>
      </div>
      <div>
        <InfoList lang={lang} />
        <TaxiCard lang={lang} />
      </div>
    </div>
  </section>
</Base>
